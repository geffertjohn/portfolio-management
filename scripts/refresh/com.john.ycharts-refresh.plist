<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the scheduled YCharts refresh.

  An AGENT, not a Daemon: Parallels needs the logged-in GUI session to run a VM,
  and a daemon has none. Install to ~/Library/LaunchAgents/ on the Mac Studio.

  Weekdays only (Monday=1 … Friday=5) at 05:30 — before the day starts, after
  YCharts has posted the previous close. RunAtLoad is false so installing it
  does not immediately fire a run.

  launchd does NOT wake a sleeping Mac, so the Studio is woken separately by
  `sudo pmset repeat wakeorpoweron MTWRF 05:25:00` — five minutes ahead. With
  `autorestart 1` it also comes back after a power cut.

  The one hole left is a reboot: FileVault is on, so the Studio stops at the
  unlock screen with no user session, and no LaunchAgent runs until someone logs
  in. Disabling FileVault on a primary workstation to fix a 5am job is the wrong
  trade, so this is accepted — the stale-data action in the app is what surfaces
  the missed days.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.john.ycharts-refresh</string>

  <!--
    The repo must live OUTSIDE ~/Desktop, ~/Documents and ~/Downloads. Those are
    TCC-protected, and a LaunchAgent holds no grant for them: bash could not read
    refresh.sh at all, exiting 126 with "Operation not permitted" before the
    script could log anything. Manual runs hid it, because Terminal already has
    Desktop access. StandardErrorPath below is what made it visible.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/johngeffert/Developer/Portfolio Management/scripts/refresh/refresh.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <!-- launchd's own capture, for failures that happen before refresh.sh can log. -->
  <key>StandardOutPath</key>
  <string>/Users/johngeffert/portfolio-refresh/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/johngeffert/portfolio-refresh/logs/launchd.err</string>

  <!-- prlctl lives in /usr/local/bin; launchd's default PATH does not include it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
