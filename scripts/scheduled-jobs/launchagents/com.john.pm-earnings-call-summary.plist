<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the "earnings-call-summary" committee job. GENERATED by
  scripts/scheduled-jobs/generate-plists.mjs — edit the JOBS table there.

  An AGENT, not a Daemon: `claude` authenticates with the stored claude.ai
  login, which lives in the login keychain and is reachable only from the
  logged-in GUI session. A daemon has none and would fail auth.

  RunAtLoad is false so installing this does not immediately fire a run.

  launchd does NOT wake a sleeping Mac. The Studio is already woken for the
  05:30 YCharts refresh by `pmset repeat wakeorpoweron`, which covers these
  later jobs too. A reboot still stops at the FileVault unlock screen with no
  user session — accepted, same as the refresh; the job_runs heartbeat is what
  surfaces a missed day.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.john.pm-earnings-call-summary</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/johngeffert/Developer/Portfolio Management/scripts/scheduled-jobs/run-job.sh</string>
    <string>earnings-call-summary</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <!-- launchd's own capture, for failures before run-job.sh can log. -->
  <key>StandardOutPath</key>
  <string>/Users/johngeffert/portfolio-jobs/logs/launchd-earnings-call-summary.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/johngeffert/portfolio-jobs/logs/launchd-earnings-call-summary.err</string>

  <!--
    launchd's default PATH does not include ~/.local/bin, where the `claude`
    binary lives. Without this the job dies with "command not found" and only
    the .err file would ever say so.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/johngeffert/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
