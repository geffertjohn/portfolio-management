# Copy to `.env` at the repo root (gitignored). Both the Vite client and the
# Express server read this one file — `server/` has no .env of its own.
#
# Every value below comes from one of two places:
#   Supabase  → Project Settings → API  (URL + keys)
#              → Project Settings → Database  (connection string)
#   FMP       → financialmodelingprep.com → Dashboard → API Keys


# ─── Supabase: required ───────────────────────────────────────────────────────

# Project Settings → API → Project URL.
# Read by BOTH the client (lib/supabase.ts) and the Express server. The VITE_
# prefix looks client-only but server/ reads this exact name off process.env —
# renaming it to SUPABASE_URL breaks the file store. Startup throws without it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API → Project API keys → anon / public.
# Client only. Safe to ship to the browser: RLS is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API → Project API keys → service_role.
# SERVER ONLY — bypasses RLS entirely. Never prefix this with VITE_, or Vite
# will inline it into the browser bundle. Only server/ reads it, to broker
# Storage uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Supabase: CLI tooling only ───────────────────────────────────────────────

# NOT read by the app or the server — only by `npx supabase db dump`, which
# regenerates supabase/schema.sql. The app is unaffected if this is stale.
#
# Copy it from Project Settings → Database → Connection string → *Session pooler*
# and paste your password in. Do not hand-build it, and do not use the
# "Direct connection" string, because:
#
#   - Direct (db.<ref>.supabase.co) is IPv6-only. The CLI runs pg_dump inside
#     Docker, whose default bridge has no IPv6, so it fails with
#     "Network unreachable" — nothing that points at addressing.
#   - The pooler's region prefix is per project. This one is aws-1-us-east-1;
#     most docs show aws-0, which resolves, accepts the connection, then
#     answers "tenant/user not found" as though the project ref were wrong.
#   - The username is postgres.<project-ref>, not postgres.
#   - Use port 5432 (session mode). 6543 is transaction mode, which pg_dump
#     cannot use.
#
# Rotate it at Project Settings → Database → Reset database password.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres


# ─── Financial Modeling Prep: required ────────────────────────────────────────

# Client only. Every stock quote, profile, financial statement, analyst figure
# and news item is fetched on demand with this key — none of it is persisted.
# The live-quote websocket authenticates with the same key, and FMP allows only
# ONE socket per key, so a second dev server or the FMP site's own quote feed
# will kick this app's connection.
VITE_FMP_API_KEY=your-fmp-api-key


# ─── Express API ──────────────────────────────────────────────────────────────

# Port the file server listens on. If you change it, set VITE_SERVER_URL to
# match or the client will keep calling 3001 and every upload will fail.
PORT=3001

NODE_ENV=development


# ─── Optional overrides (sensible defaults; omit unless you need them) ────────

# Where the client looks for the Express file server.
# Default: http://localhost:3001
# VITE_SERVER_URL=http://localhost:3001

# FMP live-quote websocket endpoint.
# Default: wss://websockets.financialmodelingprep.com
# VITE_FMP_WS_URL=wss://websockets.financialmodelingprep.com
