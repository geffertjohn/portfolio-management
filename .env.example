# Supabase (used by client and optionally by server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (do not prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used by CLI tooling (`npx supabase db dump`), never by the app.
# Use the POOLER host, not db.<ref>.supabase.co — the direct host is IPv6-only
# and is unreachable from Docker, which is what the CLI runs pg_dump in.
# The username is postgres.<project-ref>, and the region prefix is per project
# (this one is aws-1, not the aws-0 most docs show) — copy the exact string from
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Port 5432 (session mode); 6543 is transaction mode and pg_dump cannot use it.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Financial Modeling Prep — read by the client for all on-demand market data
VITE_FMP_API_KEY=your-fmp-api-key

# Express API
PORT=3001
NODE_ENV=development
